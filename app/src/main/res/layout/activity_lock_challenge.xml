<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/challenge_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_bg"
    android:padding="24dp"
    tools:context=".Activities.LockChallengeActivity">

    <!-- Top Bar matching Settings Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_challenge_top_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.1"
            android:text="VERIFICATION REQUIRED"
            android:textAllCaps="true"
            android:textColor="?attr/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_challenge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:lineSpacingMultiplier="0.8"
            android:text="Lock Challenge"
            android:textColor="?attr/text_primary"
            android:textSize="30sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/headerContainer"
        android:layout_marginTop="20dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Premium Card Matching Settings Style -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/challengeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="?attr/surface_nested">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <!-- Context Icon -->
                    <ImageView
                        android:id="@+id/iv_header_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/shield"
                        app:tint="?attr/tintGlobalColor"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_challenge_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete the challenge to unlock access"
                        android:textColor="?attr/text_secondary"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:layout_marginBottom="24dp"/>

                    <!-- ================= CHALLENGE CONTAINERS ================= -->

                    <!-- 1. MATHS CHALLENGE CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_math"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_math_equation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24 * 7 - 15 = ?"
                            android:textColor="?attr/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <!-- Outlined Material Text Field -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="?attr/tintGlobalColor"
                            app:hintTextColor="?attr/tintGlobalColor"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_math_answer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Answer"
                                android:textColor="?attr/text_primary"
                                android:textColorHint="?attr/text_tertiary"
                                android:textSize="18sp"
                                android:inputType="numberSigned"
                                android:gravity="center"
                                android:maxLength="6" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 2. SCREAM CHALLENGE CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_scream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scream or blow into mic!"
                            android:textColor="?attr/text_primary"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Volume Bar Gauge -->
                        <ProgressBar
                            android:id="@+id/pb_volume_gauge"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="?attr/tintGlobalColor"
                            android:backgroundTint="?attr/surface_nested"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_scream_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hold it: 3.0s"
                            android:textColor="?attr/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- 3. HOLD BREATH CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_breath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_breath_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10.0s"
                            android:textColor="?attr/text_primary"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="20dp"/>

                        <Button
                            android:id="@+id/btn_breath_hold"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="?attr/tintGlobalColor"
                            android:text="HOLD"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:elevation="4dp" />
                    </LinearLayout>

                    <!-- 4. TEXT TYPING CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_type_quote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Type quote exactly..."
                            android:textColor="?attr/text_secondary"
                            android:textSize="15sp"
                            android:layout_marginBottom="16dp"
                            android:padding="16dp"
                            android:background="@drawable/bg_settings_single"
                            android:backgroundTint="?attr/surface_nested"
                            android:textAlignment="viewStart"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="?attr/tintGlobalColor"
                            app:hintTextColor="?attr/tintGlobalColor"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_type_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Type here..."
                                android:textColor="?attr/text_primary"
                                android:textColorHint="?attr/text_tertiary"
                                android:textSize="15sp"
                                android:inputType="textMultiLine|textLongMessage"
                                android:gravity="start|top" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 5. SHAKE TO UNLOCK CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_shake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shake your phone vigorously!"
                            android:textColor="?attr/text_primary"
                            android:textSize="16sp"
                            android:layout_marginBottom="16dp"/>

                        <ProgressBar
                            android:id="@+id/pb_shake_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="?attr/tintGlobalColor"
                            android:backgroundTint="?attr/surface_nested"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tv_shake_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="?attr/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- 6. 1-DAY LOCKOUT CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_oneday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Strict Lock Active"
                            android:textColor="#F77381"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_oneday_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24h 00m remaining"
                            android:textColor="?attr/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>
                    </LinearLayout>

                    <!-- 7. ONE-TIME WINDOW CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_window10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_window10_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You can claim one temporary session per day."
                            android:textColor="?attr/text_secondary"
                            android:textSize="15sp"
                            android:textAlignment="center"
                            android:layout_marginBottom="20dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_activate_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Activate 10 Min Window"
                            android:backgroundTint="?attr/tintGlobalColor"
                            android:textColor="@color/white"
                            app:cornerRadius="12dp"
                            android:layout_marginBottom="12dp"/>
                    </LinearLayout>

                    <!-- 8. PIN RESET OPTIONS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/container_pin_reset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PIN Reset Options"
                            android:textColor="?attr/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Choose to start a 24-hour wait, or bypass it by typing a very long paragraph correctly."
                            android:textColor="?attr/text_secondary"
                            android:textSize="14sp"
                            android:textAlignment="center"
                            android:layout_marginBottom="20dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pin_reset_cooldown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Start 24h Cooldown"
                            android:backgroundTint="#F77381"
                            android:textColor="@color/white"
                            app:cornerRadius="12dp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tv_or_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="— OR —"
                            android:textColor="?attr/text_tertiary"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pin_reset_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Type Bypass Paragraph"
                            android:backgroundTint="?attr/tintGlobalColor"
                            android:textColor="@color/white"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                    <!-- ================= FOOTER / ACTION BUTTONS ================= -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verify Challenge"
                        android:backgroundTint="?attr/tintGlobalColor"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_challenge_cancel"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go Back"
                        android:textColor="#F77381"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
